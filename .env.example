# Copy to .env.local and fill in. .env.local is gitignored - never commit a real key.
OPENAI_API_KEY=
# Pick a model id that your account actually has. Run `npm run smoke` to list them.
OPENAI_MODEL=gpt-4o-mini
# Hard ceiling for one model call, milliseconds. Architecture budgets ~8s of a 10s total.
LLM_TIMEOUT_MS=8000
