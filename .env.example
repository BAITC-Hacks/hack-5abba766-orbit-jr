# Local development; Compose overrides host "127.0.0.1" with its "db" service.
DATABASE_URL=postgresql://career_quest:career_quest_local@127.0.0.1:54329/career_quest
POSTGRES_PASSWORD=career_quest_local
DB_PORT=54329
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# No key required for deterministic recommendations. Configure both to enable AI.
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_MS=8000
# Seed-only demo accounts. Changing these does not change already seeded passwords.
DEMO_EMPLOYEE_PASSWORD=employee-demo-2026
DEMO_HR_PASSWORD=hr-demo-2026
