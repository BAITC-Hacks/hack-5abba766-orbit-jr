{
  "name": "career-quest-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:client",
    "test:client": "node --test tests/*.test.cjs",
    "eval:ai": "tsx scripts/evaluate-ai.ts",
    "smoke:ai": "tsx scripts/evaluate-ai.ts --live --smoke",
    "start:container": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/env": "^16.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
